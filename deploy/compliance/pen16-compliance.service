# Weekly OpenSCAP evaluation, pushed to pen16. Runs as root because many checks read root-only files; it only
# needs to write its own state directory.
[Unit]
Description=Evaluate this host's compliance and send the result to pen16
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pen16-compliance
StateDirectory=pen16-compliance
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
