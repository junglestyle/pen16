# Weekly OpenSCAP evaluation, pushed to pen16. Runs as root because many checks read root-only files; it only
# needs to write its own state directory.
[Unit]
Description=Evaluate this host's compliance and send the result to pen16
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pen16-compliance
StateDirectory=pen16-compliance
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
# A profile that walks every file can grow oscap past the host's memory. The cap ends that evaluation instead
# of the host's other work, and the script goes on to the next one and exits non-zero.
MemoryMax=4G
OOMPolicy=continue
