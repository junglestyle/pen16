[Unit]
Description=pen15 runner egress policy
Documentation=https://github.com/junglestyle/pen15/blob/main/docs/SECURITY.md#scan-safety
After=docker.service
Requires=docker.service

[Service]
ExecStart=/opt/pen15/deploy/pen15-egress watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
