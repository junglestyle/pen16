# Fictional runtime secrets. The deployment repository renders the real one to /etc/pen16/pen16.env, readable only
# by root, and deploy/compose.yaml hands it to db, migrate, worker, web and listener. The runner gets none of it.

# The db service creates this role and database on first start, so the URL must agree with the three above it.
POSTGRES_USER=pen16
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pen16
PEN16_DATABASE_URL=postgresql+psycopg://pen16:change-me@db:5432/pen16

# Where alerts are posted. Leave PEN16_NTFY_URL empty to keep them queued on the dashboard. The token is optional.
PEN16_NTFY_URL=https://ntfy.example.com/pen16
PEN16_NTFY_TOKEN=tk_example

# Not secrets, so compose.yaml and the systemd units set them. Defaults in parentheses.
#   PEN16_CONFIG (/etc/pen16/pen16.toml)              PEN16_LISTENER_URL (set by compose.yaml; runner only)
#   PEN16_RUNNER_TOKEN_FILE (/etc/pen16/runner.token)  PEN16_EGRESS_MARKER (/run/pen16-egress/ready)
#   PEN16_EVIDENCE_DIR (/var/lib/pen16/evidence)       PEN16_BACKUP_DIR (/mnt/pen16-backup)
#   PEN16_RUNNER_SCOPE (/etc/pen16/runner-scope.nft)
#   On a compliance host, deploy/compliance/pen16-compliance reads PEN16_COMPLIANCE_CONF (/etc/pen16-compliance)
#   and PEN16_COMPLIANCE_STATE (/var/lib/pen16-compliance).
